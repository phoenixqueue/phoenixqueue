#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

log() {
  printf "\n==> %s\n" "$1"
}

log "Preparing environment"
./bin/setup

if [[ -x "spec/dummy/bin/rails" ]]; then
  log "Running Rails database preparation (spec/dummy)"
  docker compose run --rm ruby bash -lc "cd spec/dummy && RAILS_ENV=test bundle exec rails db:prepare"
fi

log "Running test suite"
docker compose run --rm ruby bundle exec rspec "$@"

