#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

log() {
  printf "\n==> %s\n" "$1"
}

log "Preparing environment"
./bin/setup

if [[ -x "spec/dummy/bin/rails" ]]; then
  log "Running Rails database preparation (spec/dummy)"
  (
    cd "spec/dummy"
    RAILS_ENV=test bundle exec rails db:prepare
  )
fi

log "Running test suite"
bundle exec rspec "$@"

